node_modules
.env
.next
dist
coverage
*.log
*.tsbuildinfo

# Capacitor mobile build (frontend/out is the static export input;
# android/ios keep their project source committed, just not build output)
frontend/out
frontend/android/app/build
frontend/android/.gradle
frontend/android/local.properties
frontend/android/capacitor-cordova-android-plugins/build
frontend/ios/App/Pods
frontend/ios/App/build
frontend/ios/App/DerivedData
frontend/ios/App/App/public
frontend/android/app/src/main/assets/public

# Release signing secrets -- never commit these. Losing the keystore means
# losing the ability to publish updates to the app under the same listing,
# so back it up somewhere safe outside this repo (a password manager, etc.),
# not just here.
frontend/android/keystore.properties
frontend/android/app/*.keystore
frontend/android/app/*.jks
