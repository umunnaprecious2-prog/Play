# Copy this file to .env and fill in real values. Never commit the real .env file.

# Local dev: postgresql://postgres:postgres@localhost:55432/play_db (matches docker-compose.yml)
# Render: set manually in the dashboard (Environment tab) to your Neon direct (non-pooled)
# connection string -- render.yaml marks this sync: false, so it won't be overwritten by
# a Blueprint sync. Use the direct connection, not the "-pooler" one: this app relies on
# Prisma interactive transactions, which don't play well with PgBouncer transaction pooling.
DATABASE_URL=

PORT=5000
NODE_ENV=development

# Optional: creates a real admin user on first `npm run seed` when both are set.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_SESSION_TTL_DAYS=7

# Not yet read by any backend code (reserved for a planned feature).
OPENAI_API_KEY=
