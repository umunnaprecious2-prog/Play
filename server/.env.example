# Copy this file to .env and fill in real values. Never commit the real .env file.

# Local dev: postgresql://postgres:postgres@localhost:55432/play_db (matches docker-compose.yml)
# Render: leave unset in the dashboard -- render.yaml wires this automatically from the play-db database.
DATABASE_URL=

PORT=5000
NODE_ENV=development

# Optional: creates a real admin user on first `npm run seed` when both are set.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_SESSION_TTL_DAYS=7

# Not yet read by any backend code (reserved for a planned feature).
OPENAI_API_KEY=
